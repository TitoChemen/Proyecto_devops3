# ==========================================================
# CONFIGURACIÓN DE SEGURIDAD (Credenciales Maestras)
# ==========================================================
# Cambia esta contraseña por una que tú elijas. 
# Se usará para inicializar las bases de datos y para que 
# los servicios de Java se conecten a ellas.
DB_PASSWORD=admin1234

# ==========================================================
# CONFIGURACIÓN DE RED Y BASE DE DATOS
# ==========================================================
# Nombres de las bases de datos que se crearán automáticamente
DB_NAME_VENTAS=db_ventas
DB_NAME_DESPACHOS=db_despachos

# Puertos externos para acceder desde tu PC (MySQL Workbench)
MYSQL_PORT_VENTAS=3306
MYSQL_PORT_DESPACHOS=3307

# ==========================================================
# CONFIGURACIÓN DE MICROSERVICIOS (Puertos)
# ==========================================================
PORT_VENTAS=8080
PORT_DESPACHOS=8081
PORT_FRONTEND=5173